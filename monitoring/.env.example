# Copy to .env (mode 600). Never commit .env.
# Validate format, refuse empty, then write — an empty value interpolates silently.
GRAFANA_USER=
GRAFANA_PASSWORD=
# Send-only alert bot. Exactly one process may long-poll a bot token; this one is never polled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 5G router admin (the exporter logs in → fetches → logs out per scrape)
ROUTER_URL=http://192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=
